# Build output
/target
**/target
node_modules
dist

# tauri-build regenerates this schema cache on every build; it is derived
# entirely from tauri.conf.json and the tauri crate version.
/src-tauri/gen

# The vendored PDFium tree is reproducible from a pinned tag, so only the
# script that fetches it is tracked. See vendor/pdfium/fetch.sh.
/vendor/pdfium/*
!/vendor/pdfium/fetch.sh

# Benchmark fixtures are hundreds of megabytes and are regenerated
# deterministically from a fixed seed by bench/make_fixtures.py. The manifest
# recording their sizes is tracked; the PDFs are not.
/test-fixtures/*
!/test-fixtures/MANIFEST.json
!/test-fixtures/README.md

# Benchmark output: the results quoted in CHANGELOG.md are tracked as the
# record of what was actually measured at the end of each phase; ad-hoc runs
# are not.
/bench/results/*
!/bench/results/.gitkeep
!/bench/results/phase0-*
!/bench/results/phase1-*
!/bench/results/phase2-*
!/bench/results/phase3-*
!/bench/results/phase4-*
!/bench/results/phase5-*

# Python byte cache from the fixture generator.
__pycache__/

.DS_Store
*.log
/.venv
tools/ui-harness/.samples/
