{
  "name": "pdf-studio-izul",
  "private": true,
  "version": "7.0.0-alpha.7",
  "type": "module",
  "scripts": {
    "dev": "npm run worker && vite",
    "build": "npm run worker:release && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "tauri": "tauri",
    "package": "tauri build --config src-tauri/tauri.bundle.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "cargo build -p izul-worker",
    "worker:release": "cargo build -p izul-worker --release",
    "ui:shots": "node tools/ui-harness/shoot.mjs",
    "icons": "node tools/icons/build.mjs",
    "icons:app": "node tools/icons/app-icon.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "eslint": "10.9.1",
    "globals": "^17.12.0",
    "playwright-core": "1.56.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "^3.2.7"
  }
}
