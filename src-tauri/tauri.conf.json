{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Studio Izul",
  "identifier": "id.izul.pdfstudio",
  "version": "7.0.1",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "PDF Studio Izul",
        "width": 1280,
        "height": 860,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' izul: http://izul.localhost https://izul.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost izul: http://izul.localhost https://izul.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English",
          "Indonesian"
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "description": "Dokumen PDF",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2MjdFMzEyQTlFQkUzRgpSV1EvdnA0cU1YNWlEYXdWdEZKYXRVYXZVd0ljaTZSSEw5NU1HMEhXd3RWQk95a0tkemVROStlWAo=",
      "endpoints": [
        "https://github.com/Zulaziz18/PDF-VIEWER-IZUL/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
